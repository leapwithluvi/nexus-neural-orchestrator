{
  "name": "ai-chatbot-api",
  "version": "1.0.0",
  "description": "High-performance AI Chatbot API built with Hono, Bun, Drizzle, and Groq",
  "author": "Rekayasa Studio",
  "license": "MIT",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "dev:token": "bun run scripts/get-token.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.2",
    "groq-sdk": "^1.6.0",
    "hono": "^4.13.5",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  }
}